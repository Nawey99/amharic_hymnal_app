    {
     "id": "am-sda-1975-0056",
     "number": 56,
     "title": "ክርስቶስ ይክበር",
     "englishTitle": "Not I, But Christ",
     "lyrics": "ክርስቶስ ይክበር እኔ አልከብርም\nክርስቶስ ይታይ ይታወቅ ይወደስ\nክርስቶስ ይክበር በማንኛውም ጊዜ\nክርስቶስ ይክበር በድርጊቴ ሁሉ\n\nክርስቶስ ብቻ ይንገስ በዚህ ዓለም ላይ\nክርስቶስ ብቻ አስፈላጊ ይሁን \nእኔ ልቅር እርሱ ግን ከፍ ከፍ ይበል\nእኔ ልቅር እርሱ ከፍ ከፍ ብሎ \n\nክርስቶስ ይክበር የኔ መሪ እንዲሆን\nበዚህ ዓለም ላይ በጉዞ ላይ ሳለሁ\nክርስቶስ ይክበር አሁንም ወደ ፊትም \nክርስቶስ ይክበር ደግሞም ለዘላለም\n",
     "languageCode": "am",
     "versionCode": "am-sda-1975",
     "revision": 1,
