    {
     "id": "am-sda-1975-0130",
     "number": 130,
     "title": "ወዳንተ የሱስ ሆይ",
     "englishTitle": "Longing to be With Jesus",
     "lyrics": "ወዳንተ የሱስ ሆይ ልቤ ይናፍቃል\nየአምላክ በግ ሁነህ ስለኔ ሞተሀል\n\nሰላም ለኔ ሰጠህ ተሸክመህ ቅጣት\nጠባቂዬ ሆነህ አወጣኸኝ ከሞት\n\nሥፍራን አዘጋጀህ ለኔ ባባቴ ቤት \nአይናችን ያላየው ብርሃኑም የሱስ ነው\n\nከዓለም መሄዴ በደረሰ ጊዜ \nምራኝ በብርሃንህ ልገባ አገሬ\n",
     "languageCode": "am",
