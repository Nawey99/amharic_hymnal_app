    {
     "id": "am-sda-1975-0004",
     "number": 4,
     "title": "በየሆዋ ዙፋን",
     "englishTitle": "Before Jehovah's Awful Throne",
     "lyrics": "በየሆዋ ዙፋን ዙሪያ \nእንቅረብ በደስታ እነዚያ \nከሱ ሌላ አምላክ የለም \nለመፍጠር ለማጥፋትም\n\nበስልጣኑ ሣንረዳው \nሰውን ከሸክላ የሰራው \nእንደ በጐችም ጠፍተን ሣል \nበደሙ መልሶ ገዛን \n\nቤቱን በምስጋና ሞልተን \nሲያስተጋባ መዝሙራችን \nየምድር ነገድ ሁሉ \nእርሱን ያመሰግናሉ\n\nትዕዛዙ ለሁሉ ነው \nፍቅሩም ዘላለማዊ ነው \nዕውነቱም እንደ ህንፃ ነው \nዘመን ከቶ የማይሽረው\n",
     "languageCode": "am",
     "versionCode": "am-sda-1975",
     "revision": 1,
