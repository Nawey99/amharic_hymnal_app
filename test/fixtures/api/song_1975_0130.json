{"success":true,"data":{"id":"am-sda-1975-0130","number":130,"title":"ወዳንተ የሱስ ሆይ","englishTitle":"Longing to be With Jesus","lyrics":"ወዳንተ የሱስ ሆይ ልቤ ይናፍቃል\nየአምላክ በግ ሁነህ ስለኔ ሞተሀል\n\nሰላም ለኔ ሰጠህ ተሸክመህ ቅጣት\nጠባቂዬ ሆነህ አወጣኸኝ ከሞት\n\nሥፍራን አዘጋጀህ ለኔ ባባቴ ቤት \nአይናችን ያላየው ብርሃኑም የሱስ ነው\n\nከዓለም መሄዴ በደረሰ ጊዜ \nምራኝ በብርሃንህ ልገባ አገሬ\n","languageCode":"am","versionCode":"am-sda-1975","revision":1,"category":{"id":"22bb078b-958b-49b1-856b-54d77b04352c","slug":"hope","name":"ተስፋ","englishName":"Hope"},"audio":{"songId":"am-sda-1975-0130","available":false},"sheetMusic":{"available":true,"pageCount":1,"pages":[{"pageNumber":1,"pageSide":"RIGHT","fileName":"132R.webp","contentType":"image/webp","sizeBytes":269036,"checksumSha256":"1f5f69b06de9dce77e208fc1a250df39c2bdb4ad4d305573f4c7df382c9ed7bb","isShared":false,"borrowedFromVersionCode":"am-sda-2004","downloadUrl":"https://amharichymnalbackend.vercel.app/api/v1/songs/am-sda-1975-0130/sheet-music/pages/1/file?language=am&version=am-sda-1975"}]},"rights":{"status":"UNKNOWN","holder":null,"note":null},"otherEditions":[{"songId":"am-sda-1961-0165","number":165,"versionCode":"am-sda-1961","versionTitle":"Amharic Adventist Hymnal (1961)","languageCode":"am"},{"songId":"am-sda-2004-0132","number":132,"versionCode":"am-sda-2004","versionTitle":"Amharic Adventist Hymnal (2004)","languageCode":"am"}],"similarEditions":[],"isActive":true,"deletedAt":null,"createdAt":"2026-09-18T16:34:56.518Z","updatedAt":"2026-09-21T16:40:55.010Z"}}