HOST=127.0.0.1
PORT=8787
SDA_HYMNAL_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/wudase_sda
HAGERIGNA_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/wudase_hagerigna
# Production only: privileged owner URLs used by the migration command.
# Runtime URLs above should use a separate least-privileged login role.
SDA_HYMNAL_MIGRATION_DATABASE_URL=
HAGERIGNA_MIGRATION_DATABASE_URL=
CONTENT_BOOTSTRAP_OWNER_EMAIL=owner@example.org
CONTENT_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-strong-password
CONTENT_BOOTSTRAP_OWNER_NAME=Wudase Owner
CONTENT_SESSION_HOURS=12
CONTENT_PUBLIC_MODE=live
CONTENT_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
# Enable only behind a trusted reverse proxy that replaces forwarded headers.
CONTENT_TRUST_PROXY=false
CONTENT_FORCE_HTTPS=false
ALLOW_LEGACY_CONTENT_ADMIN=false
# Development recovery only. Never enable this shared token in production.
CONTENT_ADMIN_TOKEN=
