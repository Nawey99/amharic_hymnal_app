generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("CONTENT_DATABASE_URL")
}

model Language {
  code        String   @id
  nativeName  String   @map("native_name")
  englishName String   @map("english_name")
  scriptCode  String   @default("Ethi") @map("script_code")
  direction   String   @default("ltr")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  books      Book[]
  categories Category[]
  works      Work[]

  @@map("languages")
}

model Book {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  languageCode String  @map("language_code")
  title        String
  subtitle     String?
  bookType     String  @map("book_type")
  sourceNote   String? @map("source_note")
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  language Language      @relation(fields: [languageCode], references: [code])
  editions BookEdition[]

  @@index([languageCode])
  @@map("books")
}

model BookEdition {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookId          String   @map("book_id") @db.Uuid
  slug            String   @unique
  versionKey      String   @unique @map("version_key")
  title           String
  nativeTitle     String?  @map("native_title")
  publicationYear Int?     @map("publication_year")
  status          String   @default("draft")
  editionType     String   @default("primary") @map("edition_type")
  sortOrder       Int      @default(0) @map("sort_order")
  sourceNote      String?  @map("source_note")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  book    Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  entries BookEntry[]

  @@index([bookId])
  @@map("book_editions")
}

model Category {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  languageCode String  @map("language_code")
  name         String
  englishName  String? @map("english_name")
  description  String?
  sortOrder    Int     @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  language Language    @relation(fields: [languageCode], references: [code])
  entries  BookEntry[]

  @@map("categories")
}

model Work {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonicalKey        String   @unique @map("canonical_key")
  primaryLanguageCode String   @map("primary_language_code")
  defaultTitle        String   @map("default_title")
  defaultEnglishTitle String?  @map("default_english_title")
  canonicalLyrics     String   @default("") @map("canonical_lyrics")
  normalizedTitle     String?  @map("normalized_title")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  primaryLanguage Language    @relation(fields: [primaryLanguageCode], references: [code])
  entries         BookEntry[]
  mediaLinks      MediaLink[]

  @@index([primaryLanguageCode])
  @@map("works")
}

model BookEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  editionId   String   @map("edition_id") @db.Uuid
  workId      String   @map("work_id") @db.Uuid
  entryNumber Int      @map("entry_number")
  title       String?
  englishTitle String? @map("english_title")
  lyrics      String?
  categoryId  String?  @map("category_id") @db.Uuid
  sourceKey   String   @map("source_key")
  sourceIndex Int      @map("source_index")
  metadata    Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  edition   BookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  work      Work        @relation(fields: [workId], references: [id])
  category  Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  mediaLinks MediaLink[]

  @@unique([editionId, entryNumber])
  @@unique([editionId, sourceKey, sourceIndex])
  @@index([workId])
  @@index([categoryId])
  @@map("book_entries")
}

model MediaAsset {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaType      String   @map("media_type")
  storageProvider String  @default("external") @map("storage_provider")
  storageKey     String   @map("storage_key")
  publicUrl      String?  @map("public_url")
  mimeType       String   @map("mime_type")
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  checksumSha256 String?  @map("checksum_sha256")
  pageLabel      String?  @map("page_label")
  durationSeconds Int?    @map("duration_seconds")
  widthPx        Int?     @map("width_px")
  heightPx       Int?     @map("height_px")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  links MediaLink[]

  @@unique([storageProvider, storageKey])
  @@index([mediaType])
  @@map("media_assets")
}

model MediaLink {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  workId       String?  @map("work_id") @db.Uuid
  bookEntryId  String?  @map("book_entry_id") @db.Uuid
  relationType String   @map("relation_type")
  sortOrder    Int      @default(0) @map("sort_order")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  work       Work?      @relation(fields: [workId], references: [id], onDelete: Cascade)
  bookEntry  BookEntry? @relation(fields: [bookEntryId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([bookEntryId])
  @@map("media_links")
}

model ContentRelease {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releaseKey     String   @unique @map("release_key")
  versionLabel   String   @map("version_label")
  description    String?
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  isCurrent      Boolean   @default(false) @map("is_current")
  schemaVersion  Int       @default(1) @map("schema_version")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdByName  String    @default("system") @map("created_by_name")
  checksumSha256 String?   @map("checksum_sha256")
  manifest       Json      @default("{}")
  bundle         Json      @default("{}")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("content_releases")
}

model ContentUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  displayName  String    @map("display_name")
  role         String    @default("editor")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([role, isActive])
  @@map("content_users")
}

model ContentSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("content_sessions")
}

model ContentAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  instructions String?
  catalog      String
  versionKey   String?   @map("version_key")
  categorySlug String?   @map("category_slug")
  startNumber  Int?      @map("start_number")
  endNumber    Int?      @map("end_number")
  assigneeId   String    @map("assignee_id") @db.Uuid
  createdById  String    @map("created_by_id") @db.Uuid
  status       String    @default("active")
  dueAt        DateTime? @map("due_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([assigneeId, status])
  @@index([catalog, versionKey, status])
  @@map("content_assignments")
}

model ContentWorkflow {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalog          String
  workId           String    @map("work_id") @db.Uuid
  status           String    @default("draft")
  revision         Int       @default(1)
  updatedById      String?   @map("updated_by_id") @db.Uuid
  submittedById    String?   @map("submitted_by_id") @db.Uuid
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedById     String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewSummary    String?   @map("review_summary")
  approvedRevision Int?      @map("approved_revision")
  baselineSnapshot Json       @default("{}") @map("baseline_snapshot")
  submittedSnapshot Json      @default("{}") @map("submitted_snapshot")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([catalog, workId])
  @@index([catalog, status, updatedAt])
  @@map("content_workflows")
}

model ContentComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalog   String
  workId    String   @map("work_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([catalog, workId, createdAt])
  @@map("content_comments")
}

model ContentActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action      String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorName   String   @map("actor_name")
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  details     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("content_activity_logs")
}

model ContentImportIssue {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceName String   @map("source_name")
  issueKey   String   @map("issue_key")
  severity   String
  issueType  String   @map("issue_type")
  message    String
  metadata   Json     @default("{}")
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sourceName, issueKey])
  @@index([severity, issueType, resolvedAt])
  @@map("content_import_issues")
}

model ContentAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalog    String
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  workId     String?  @map("work_id") @db.Uuid
  actor      String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([catalog, createdAt])
  @@index([workId, createdAt])
  @@map("content_audit_logs")
}

view SdaHymnalSong {
  workId          String  @unique @map("work_id") @db.Uuid
  canonicalKey    String  @map("canonical_key")
  title           String
  englishTitle    String? @map("english_title")
  newEntryId      String? @map("new_entry_id") @db.Uuid
  newHymnalNumber Int?    @map("new_hymnal_number")
  newLyrics       String? @map("new_lyrics")
  oldEntryId      String? @map("old_entry_id") @db.Uuid
  oldHymnalNumber Int?    @map("old_hymnal_number")
  oldLyrics       String? @map("old_lyrics")
  matchStatus     String  @map("match_status")

  @@map("sda_hymnal_songs")
}

view SdaHymnalSheetMusic {
  workId           String  @map("work_id") @db.Uuid
  newHymnalNumber  Int?    @map("new_hymnal_number")
  oldHymnalNumber  Int?    @map("old_hymnal_number")
  title            String
  englishTitle     String? @map("english_title")
  mediaAssetId     String  @map("media_asset_id") @db.Uuid
  storageProvider  String  @map("storage_provider")
  storageKey       String  @map("storage_key")
  publicUrl        String? @map("public_url")
  mimeType         String  @map("mime_type")
  fileSizeBytes    BigInt? @map("file_size_bytes")
  pageLabel        String? @map("page_label")
  sortOrder        Int     @map("sort_order")
  assetPath        String? @map("asset_path")
  originalFileName String? @map("original_file_name")

  @@unique([workId, mediaAssetId])
  @@map("sda_hymnal_sheet_music")
}
